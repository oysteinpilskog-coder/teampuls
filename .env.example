# Copy to .env.local and fill in values. Never commit .env.local.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL + anon key from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional override — defaults to claude-sonnet-4-6 in code
# ANTHROPIC_MODEL=

# ── CloudMailin ───────────────────────────────────────────────────────────
# Shared secret passed as ?token=… on the inbound webhook URL.
# Generate a random 32+ char string and configure both here and in CloudMailin.
CLOUDMAILIN_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
# Public base URL — used in OG metadata and email links.
# Local: http://localhost:3000  Prod: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
